{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "web/src",
    "shared",
    "core/work/types.ts",
    "core/work/state.ts",
    "core/watch/types.ts"
  ]
}