{
  "name": "@hey-triage/triage",
  "version": "0.2.0",
  "type": "module",
  "description": "Ranked work inbox for engineers — every item arrives with its action drafted, dispatch straight into your local Claude Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-triage/triage.git"
  },
  "homepage": "https://heytriage.com",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "triage": "dist/server/index.js",
    "triage-mcp": "dist/server/mcp.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "dev:server": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "dev:web": "vite",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.publish.json",
    "start": "tsx server/index.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.37.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
